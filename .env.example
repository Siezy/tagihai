# TagihAI — copy to .env and fill in. Never commit a real .env.
# The app runs WITHOUT any of these (mock mode) — keys only switch on
# live PayPal sandbox invoices and Gemini intent parsing.

# PayPal sandbox app credentials (developer.paypal.com → My Apps & Credentials → Sandbox).
# Used ONLY against api-m.sandbox.paypal.com. No real money ever moves.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Google AI Studio (aistudio.google.com) free-tier API key, for intent parsing.
# Without it, TagihAI falls back to a local regex parser.
GEMINI_API_KEY=

# Optional: server port (default 3000)
# PORT=3000
